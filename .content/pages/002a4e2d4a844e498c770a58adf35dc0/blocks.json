    "in_trash": false,
    "type": "paragraph",
    "paragraph": {
      "rich_text": [
        {
          "type": "text",
          "text": {
            "content": "I work with founders who are building their products with AI coding agents. Tools like Claude Code let a small team, or a non-technical founder, ship software remarkably fast. What they don't provide is the foundation underneath: infrastructure, data models, and guardrails that keep that speed from turning into risk once real clients and real data are involved.",
            "link": null
          },
          "annotations": {
            "bold": false,
            "italic": false,
            "strikethrough": false,
            "underline": false,
            "code": false,
            "color": "default"
          },
          "plain_text": "I work with founders who are building their products with AI coding agents. Tools like Claude Code let a small team, or a non-technical founder, ship software remarkably fast. What they don't provide is the foundation underneath: infrastructure, data models, and guardrails that keep that speed from turning into risk once real clients and real data are involved.",
          "href": null
        }
      ],
      "icon": null,
      "color": "default"
    },
    "archived": false
  },
